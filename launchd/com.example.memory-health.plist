<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily self-reported health (disk%, backup/capture log status) pushed to the
  claude-harness repo, so a daily cloud /schedule job can alert on it without
  ever needing SSH access to this machine — it only reads status/*.json via
  the GitHub API. Daily 08:30, before the weekly backup's 09:00 Sunday slot.

    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.example.memory-health.plist  # disable
    launchctl kickstart -k gui/$(id -u)/com.example.memory-health                          # run now
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.memory-health</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>__HOME__/.claude/scripts/report-health.mjs</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/logs/memory-health.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/logs/memory-health.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
