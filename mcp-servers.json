{
  "mcpServers": {
    "mobbin": {
      "type": "http",
      "url": "https://api.mobbin.com/mcp"
    },
    "c4ai-sse": {
      "type": "sse",
      "url": "http://localhost:11235/mcp/sse",
      "headers": {
        "Authorization": "<YOUR_Authorization>"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "skillspector": {
      "type": "stdio",
      "command": "skillspector",
      "args": [
        "mcp"
      ],
      "env": {}
    },
    "gitmcp": {
      "type": "http",
      "url": "https://gitmcp.io/docs"
    },
    "gbrain": {
      "type": "stdio",
      "command": "$HOME/.bun/bin/gbrain",
      "args": [
        "serve",
        "--surface",
        "starter"
      ],
      "env": {}
    },
    "magic": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic@latest"
      ],
      "env": {
        "API_KEY": "<YOUR_API_KEY>"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless"
      ],
      "env": {}
    },
    "greptile": {
      "type": "http",
      "url": "https://api.greptile.com/mcp"
    }
  }
}
