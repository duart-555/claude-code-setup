# Copy to ~/.claude/.env.memory-backup and fill in. Then: chmod 600 ~/.claude/.env.memory-backup
#
#   node ~/.claude/scripts/memory-backup.mjs           # back up every project's memory
#   node ~/.claude/scripts/memory-restore-verify.mjs   # the drill — non-zero on mismatch
#
# This file is a TEMPLATE and holds no real values. The real file is never committed
# and is read only by the two scripts above.

# --- encryption ---------------------------------------------------------------
# The age RECIPIENT (public key). The backup refuses to run without it rather than
# writing plaintext: these memories carry commercial detail.
#   age-keygen -o ~/.age/memory.txt        # prints the public key
AGE_PUBLIC_KEY=age1replace_with_your_public_key

# To RESTORE you need the private half. Either point at the key file:
# AGE_IDENTITY_FILE=/Users/you/.age/memory.txt
# or supply the material directly (written to a 0600 temp file, deleted after use):
# AGE_PRIVATE_KEY=AGE-SECRET-KEY-1...
#
# KEEP A COPY OF THE PRIVATE KEY SOMEWHERE OTHER THAN THIS MAC. An encrypted
# offsite backup whose only key sits on the disk you are protecting against is not
# a backup. A password manager or a printed copy in a drawer both qualify.

# --- destination --------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name

# Set this if the bucket was created with a jurisdiction. An EU bucket is NOT
# reachable on the default endpoint — it answers `Access Denied`, which reads as a
# permissions problem and sends you off rebuilding tokens. It is a routing problem.
# R2_JURISDICTION=eu

# Overrides the derived Cloudflare endpoint; used to point the scripts at a local
# S3-compatible server for testing.
# R2_ENDPOINT=http://127.0.0.1:9000
